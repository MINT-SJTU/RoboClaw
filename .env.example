# Evo Studio dataset pool (S3-compatible)
#
# Works with Cloudflare R2, MinIO, AWS S3, and S3-compatible providers.
# Do not commit real access keys.
# Copy this file to .env or .env.local for local development; both are ignored
# by Git and loaded automatically by the dataset storage backend.

EVO_STUDIO_STORAGE_PROVIDER=r2
EVO_STUDIO_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
EVO_STUDIO_S3_BUCKET=evo-studio-demo-datasets
EVO_STUDIO_S3_ACCESS_KEY=
EVO_STUDIO_S3_SECRET_KEY=
EVO_STUDIO_S3_REGION=auto
EVO_STUDIO_S3_PREFIX=
EVO_STUDIO_S3_PUBLIC_BASE_URL=

# Data pool policy
EVO_STUDIO_PENDING_RETENTION_DAYS=14
EVO_STUDIO_FREE_PRIVATE_RETENTION_DAYS=30
EVO_STUDIO_CONTRIBUTOR_PRIVATE_RETENTION_DAYS=90
EVO_STUDIO_TEAM_PRIVATE_RETENTION_DAYS=180
EVO_STUDIO_FREE_USER_QUOTA_BYTES=10737418240
EVO_STUDIO_CONTRIBUTOR_QUOTA_BYTES=53687091200
EVO_STUDIO_TEAM_USER_QUOTA_BYTES=214748364800
EVO_STUDIO_BILLING_ALERT_USD=20
EVO_STUDIO_BILLING_CONFIRM_USD=50
EVO_STUDIO_ACCEPTED_UPLOAD_EXTENSIONS=.tar,.tar.gz,.tgz,.zip,.hdf5,.h5,.parquet,.jsonl
EVO_STUDIO_CONTRIBUTOR_USERS=
EVO_STUDIO_TEAM_USERS=

# S3-compatible provider aliases are also accepted for local deployments:
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# Still set EVO_STUDIO_S3_BUCKET because most providers do not expose bucket
# name through the generic AWS_* variables.

# Identity mode for private dataset isolation.
# dev:            local UI may pass username for development (no auth enforced).
# trusted_header: production gateway injects X-Evo-Studio-User header (trusted).
# evomind:        validate Bearer token against EvoMind cloud API on every request.
EVO_STUDIO_AUTH_MODE=dev

# Local development only. Keep disabled in product demos unless you explicitly
# want HuggingFace datasets downloaded to the machine running the backend.
ROBOCLAW_ALLOW_LOCAL_REMOTE_DATASET_INGEST=0

# Server-side authorization connection registry for private training sources.
# Frontend users only select an authRef such as "hf-team-models"; real tokens
# remain on the backend server. Do not commit real values.
#
# User-created private connections are stored in this private JSON file when
# users add a HuggingFace/ModelScope/Git/S3/OSS/R2 connection from the web UI.
# EVO_STUDIO_AUTH_REFS_FILE=/home/evo-studio/.roboclaw/auth_refs.json
#
# Team/global read-only connections can also be injected as deployment secrets:
# EVO_STUDIO_AUTH_REFS_JSON={"connections":[{"id":"hf-team-models","label":"HF private models","kind":"model","provider":"huggingface","env":{"HF_TOKEN":"EVO_STUDIO_HF_TOKEN"}},{"id":"team-s3-data","label":"Team S3 datasets","kind":"data","provider":"s3","env":{"AWS_ACCESS_KEY_ID":"EVO_STUDIO_DATA_S3_ACCESS_KEY","AWS_SECRET_ACCESS_KEY":"EVO_STUDIO_DATA_S3_SECRET_KEY"}}]}
#
# EVO_STUDIO_HF_TOKEN=
# EVO_STUDIO_DATA_S3_ACCESS_KEY=
# EVO_STUDIO_DATA_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# EVO_Train cloud training bridge
#
# Required for cloud training via Evo Studio. Leave blank to disable cloud
# training (local training still works without these).
# ---------------------------------------------------------------------------

# TCP address of the EVO_Train backend service (required to enable cloud training)
ROBOCLAW_EVO_TRAIN_HOST=
ROBOCLAW_EVO_TRAIN_PORT=9000

# Cloud provider identifier (e.g. aliyun, autodl, seetacloud)
ROBOCLAW_EVO_TRAIN_PROVIDER=aliyun

# Default username passed to EVO_Train jobs
ROBOCLAW_EVO_TRAIN_USERNAME=

# Cloud region (default: cn-hangzhou)
ROBOCLAW_EVO_TRAIN_REGION=cn-hangzhou

# Path to a shell env file sourced on the cloud instance before training starts
# ROBOCLAW_EVO_TRAIN_ENV_FILE=

# Cloud-side paths for datasets and checkpoints
# ROBOCLAW_EVO_TRAIN_DATASET_ROOT=/root/autodl-tmp/datasets
# ROBOCLAW_EVO_TRAIN_CHECKPOINT_ROOT=/root/autodl-tmp/checkpoints

# Training job defaults
ROBOCLAW_EVO_TRAIN_GPU_COUNT=1
ROBOCLAW_EVO_TRAIN_STEPS_PER_EPOCH=10000
ROBOCLAW_EVO_TRAIN_CHECKPOINT_FREQUENCY=1

# Request timeout in seconds for bridge calls (default: 10)
# ROBOCLAW_EVO_TRAIN_TIMEOUT=10

# ---------------------------------------------------------------------------
# RLinf integration (VLA-RL training via RLinf)
#
# Clone https://github.com/RLinf/RLinf.git and set the path below to enable
# RLinf-based training recipes in Evo Studio.
# ---------------------------------------------------------------------------

# ROBOCLAW_RLINF_REPO_PATH=/root/autodl-tmp/RLinf
